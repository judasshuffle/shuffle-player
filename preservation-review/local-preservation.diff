diff --git a/bin/wait_ptt.py b/bin/wait_ptt.py
new file mode 100755
index 0000000..be164e9
--- /dev/null
+++ b/bin/wait_ptt.py
@@ -0,0 +1,30 @@
+#!/usr/bin/env python3
+import sys, time
+from gpiozero import Button
+
+def main():
+    pin = int(sys.argv[1]) if len(sys.argv) > 1 else 17
+    b = Button(pin, pull_up=True, bounce_time=0.05)
+
+    # Ensure we start from "released" state (prevents instant triggers)
+    while b.is_pressed:
+        time.sleep(0.02)
+
+    # Wait for an actual press
+    b.wait_for_press()
+
+    # Require a deliberate press (debounce noise / phantom taps)
+    t0 = time.time()
+    while b.is_pressed and (time.time() - t0) < 0.15:
+        time.sleep(0.01)
+
+    # If it released too quickly, treat as noise and wait again
+    if not b.is_pressed:
+        return main()
+
+    # Now wait for release to end the PTT cycle
+    b.wait_for_release()
+    return 0
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/bin/wait_ptt.sh b/bin/wait_ptt.sh
new file mode 100755
index 0000000..9baa8d6
--- /dev/null
+++ b/bin/wait_ptt.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+PIN="${1:-17}"
+CHIP="${2:-gpiochip0}"
+
+# Strong debounce (button bounce was giving duplicate edges)
+DEBOUNCE="200ms"
+
+# Wait for a real press then a real release
+gpiomon -c "$CHIP" -b pull-up -p "$DEBOUNCE" -e falling -n 1 -q "$PIN" >/dev/null
+gpiomon -c "$CHIP" -b pull-up -p "$DEBOUNCE" -e rising  -n 1 -q "$PIN" >/dev/null
